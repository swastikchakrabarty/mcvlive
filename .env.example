# ==============================================================================
# Morland Chambers Vector (MCV) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials, tokens, or production values into source control.
# All environment variables are validated at runtime via `src/common/config/env.ts`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Canonical public-facing application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical public-facing API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Local HTTP server port
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL via Supabase / Neon)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (PgBouncer / Supabase transaction pooler)
# Used for standard application queries in serverless runtime
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection string to PostgreSQL (bypassing pooler on port 5432)
# Required for database migrations, schema pushes, and administrative DDL
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & IDENTITY (Clerk / Supabase Auth)
# ------------------------------------------------------------------------------
# Public API key for client-side authentication SDK
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key_12345

# Secret API key for backend session verification, user management, and JWT validation
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key_67890

# Standard routing paths for authentication workflows
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Optional: Supabase Auth fallback / alternate credentials (if using Supabase Auth)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 4. SOFTWARE SALES & COMMERCE (Stripe)
# ------------------------------------------------------------------------------
# Public publishable key for Stripe Elements / browser SDK
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_publishable_key

# Stripe secret key for server-side payment intent creation, invoices, and subscriptions
STRIPE_SECRET_KEY=sk_test_sample_stripe_secret_key

# Webhook secret key used to verify Stripe webhook signatures (e.g. payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=whsec_sample_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 5. RATE LIMITING & CACHING (Upstash Redis)
# ------------------------------------------------------------------------------
# Upstash Redis REST URL for distributed rate limiting across edge and serverless functions
UPSTASH_REDIS_REST_URL=https://sample-redis-id.upstash.io

# Upstash Redis REST authentication token
UPSTASH_REDIS_REST_TOKEN=sample_upstash_redis_token

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & ERROR TELEMETRY (Sentry)
# ------------------------------------------------------------------------------
# Public Sentry DSN for client and server error reporting
NEXT_PUBLIC_SENTRY_DSN=https://sample_key@o000000.ingest.sentry.io/0000000

# Optional: Sentry build-time auth token for source map uploads
# SENTRY_AUTH_TOKEN=sntrys_sample_token

# ------------------------------------------------------------------------------
# 7. SECURE STORAGE & OBJECT PERSISTENCE
# ------------------------------------------------------------------------------
# Secret key used for signing client pre-signed upload & download URLs via HMAC-SHA256
STORAGE_SIGNING_SECRET=sample_mcv_storage_hmac_signing_secret_key_32bytes_min

